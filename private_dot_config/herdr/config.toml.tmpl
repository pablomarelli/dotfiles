onboarding = false
[terminal]
# Match the tmux habit of opening new panes/tabs/workspaces from the current context.
new_cwd = "follow"

[keys]
# tmux-style prefix from ~/.config/tmux/tmux.conf.
prefix = "ctrl+space"

# Workspace/session workflow.
open_notification_target = ""
workspace_picker = ""

# Tab/window workflow.
new_tab = ""
next_tab = "prefix+n"
previous_tab = "prefix+p"
switch_tab = "prefix+1..9"

# Pane workflow.
split_horizontal = "prefix+\""
split_vertical = "prefix+%"
close_pane = "prefix+x"
zoom = "prefix+z"
focus_pane_left = "prefix+h"
focus_pane_down = "prefix+j"
focus_pane_up = "prefix+k"
focus_pane_right = "prefix+l"

# tmux-style visual/copy mode.
copy_mode = "alt+v"
edit_scrollback = ""

[[keys.command]]
key = "ctrl+h"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/bin/herdr-python herdr-navigator left h"
description = "Navigate left with Neovim passthrough"

[[keys.command]]
key = "ctrl+j"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/bin/herdr-python herdr-navigator down j"
description = "Navigate down with Neovim passthrough"

[[keys.command]]
key = "ctrl+k"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/bin/herdr-python herdr-navigator up k"
description = "Navigate up with Neovim passthrough"

[[keys.command]]
key = "ctrl+l"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/bin/herdr-python herdr-navigator right l"
description = "Navigate right with Neovim passthrough"

[[keys.command]]
key = "prefix+c"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/bin/herdr-python herdr-new-tab"
description = "Create a project-named tab"

[[keys.command]]
key = "prefix+o"
type = "pane"
command = "{{ .chezmoi.homeDir }}/.config/herdr/bin/herdr-python herdr-tv-workspace"
description = "Pick a workspace with Television"

[[keys.command]]
key = "alt+."
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/bin/herdr-python herdr-last-workspace"
description = "Toggle to the last workspace"

[[keys.command]]
key = "alt+comma"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/bin/herdr-python herdr-last-tab"
description = "Toggle to the last tab"

[ui]
show_agent_labels_on_pane_borders = false
# Native tmux-style status area, alongside the tabs.
tab_bar_position = "top"
tab_bar_right_separator = " | "
tab_bar_right = [
  { type = "zoom" },
  { type = "hostname" },
  { type = "command", command = 'cd "${HERDR_ACTIVE_PANE_CWD:-$HOME}" && (git symbolic-ref --quiet --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || true)', interval_seconds = 5, timeout_seconds = 2 },
{{ if eq .chezmoi.os "darwin" }}
  { type = "command", command = 'sh "$HOME/.config/herdr/status.sh"', interval_seconds = 5, timeout_seconds = 3 },
{{ else }}
  { type = "command", command = 'sh "$HOME/.config/herdr/bin/herdr-system-health"', interval_seconds = 5, timeout_seconds = 3 },
{{ end }}
  { type = "datetime", format = "%a %d %b %H:%M" },
]

[theme]
name = "gruvbox"
auto_switch = false

[theme.custom]
overlay1 = "#fabd2f"

[experimental]
kitty_graphics = true

[ui.toast]
delivery = "herdr"
