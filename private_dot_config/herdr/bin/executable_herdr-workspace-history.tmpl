# Invoked by herdr-python to avoid project-specific mise Python settings.
"""Record every Herdr workspace and tab focus change, whatever triggered it.

Herdr has no focus hook, so the TUI's own navigation (Agents tab, sidebar
clicks, built-in keys) never reaches herdr-last-workspace or herdr-last-tab.
This watcher subscribes to focus events and keeps the shared history current:
the previous workspace, and the previous tab of each workspace.
"""
import argparse
import fcntl
import json
import os
import socket
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Iterable


CACHE = Path.home() / ".cache" / "herdr-last"
PREVIOUS_PATH = CACHE / "workspace"
MRU_PATH = CACHE / "workspace-mru.json"
LOCK_PATH = CACHE / "workspace-history.lock"
MRU_LIMIT = 200


def socket_path() -> str:
    return os.environ.get("HERDR_SOCKET_PATH") or str(Path.home() / ".config" / "herdr" / "herdr.sock")


def snapshot_workspaces() -> list[dict]:
    result = subprocess.run(("herdr", "api", "snapshot"), text=True, capture_output=True)
    if result.returncode != 0:
        return []
    try:
        data = json.loads(result.stdout)
        return data.get("result", data)["workspaces"]
    except (json.JSONDecodeError, KeyError, TypeError):
        return []


def tab_state_path(workspace_id: str) -> Path:
    return CACHE / f"tab-{workspace_id.replace(':', '_')}"


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as handle:
        handle.write(text)
        temp = Path(handle.name)
    try:
        temp.replace(path)
    finally:
        temp.unlink(missing_ok=True)


def read_mru() -> list[str]:
    try:
        data = json.loads(MRU_PATH.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return []
    return [item for item in data if isinstance(item, str)] if isinstance(data, list) else []


def updated_mru(current: str, previous: str, ordered: list[str]) -> list[str]:
    head = [current, previous]
    return [*head, *(item for item in ordered if item not in head)][:MRU_LIMIT]


def record_workspace(previous: str, current: str) -> None:
    write_atomic(PREVIOUS_PATH, previous + "\n")
    write_atomic(MRU_PATH, json.dumps(updated_mru(current, previous, read_mru())))


def record_tab(workspace_id: str, previous: str) -> None:
    write_atomic(tab_state_path(workspace_id), previous + "\n")


class FocusState:
    def __init__(self, workspace: str | None, tabs: dict[str, str]) -> None:
        self.workspace = workspace
        self.tabs = tabs

    @classmethod
    def from_snapshot(cls, workspaces: list[dict]) -> "FocusState":
        focused = next((w["workspace_id"] for w in workspaces if w.get("focused")), None)
        tabs = {w["workspace_id"]: w["active_tab_id"] for w in workspaces if w.get("active_tab_id")}
        return cls(focused, tabs)

    def workspace_focused(self, target: str) -> None:
        # Herdr re-emits focus for the already focused workspace; only real switches count.
        if target == self.workspace:
            return
        if self.workspace is not None:
            record_workspace(self.workspace, target)
        self.workspace = target

    def tab_focused(self, workspace_id: str, target: str) -> None:
        current = self.tabs.get(workspace_id)
        if target == current:
            return
        if current is not None:
            record_tab(workspace_id, current)
        self.tabs[workspace_id] = target


def follow(lines: Iterable[str], state: FocusState) -> None:
    for line in lines:
        message = json.loads(line)
        if "error" in message:
            raise SystemExit(f"herdr events.subscribe failed: {message['error']}")
        event = message.get("event")
        data = message.get("data") or {}
        if event == "workspace_focused":
            state.workspace_focused(data["workspace_id"])
        elif event == "tab_focused":
            state.tab_focused(data["workspace_id"], data["tab_id"])


def acquire_lock():
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    handle = LOCK_PATH.open("w")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        return None
    return handle


def watch() -> int:
    lock = acquire_lock()
    if lock is None:
        return 0
    with socket.socket(socket.AF_UNIX) as client:
        try:
            client.connect(socket_path())
        except OSError as exc:
            raise SystemExit(f"cannot connect to herdr socket {socket_path()}: {exc}")
        request = {"id": "workspace-history", "method": "events.subscribe",
                   "params": {"subscriptions": [{"type": "workspace.focused"}, {"type": "tab.focused"}]}}
        client.sendall((json.dumps(request) + "\n").encode())
        # Read the focus after subscribing so no switch falls between the two.
        state = FocusState.from_snapshot(snapshot_workspaces())
        # Exits on EOF when the Herdr server stops; the next shell, alt+. or alt+, restarts it.
        follow(client.makefile(encoding="utf-8"), state)
    return 0


def ensure() -> int:
    lock = acquire_lock()
    if lock is None:
        return 0
    lock.close()
    subprocess.Popen(
        (sys.executable, os.path.abspath(__file__)),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Track Herdr workspace focus history.")
    parser.add_argument("--ensure", action="store_true", help="start a detached watcher unless one is running")
    args = parser.parse_args()
    return ensure() if args.ensure else watch()


if __name__ == "__main__":
    raise SystemExit(main())
