# Invoked by herdr-python to avoid project-specific mise Python settings.
import argparse
import json
import os
import shutil
import subprocess
from pathlib import Path


VIM_NAMES = {"vim", "nvim", "vimdiff", "nvimdiff"}
# Remote shells get the raw key so a Herdr/Vim on the other end can handle it.
SSH_NAMES = {"ssh", "mosh-client"}
PASSTHROUGH_NAMES = VIM_NAMES | SSH_NAMES


def herdr(*args: str) -> str:
    configured = os.environ.get("HERDR_BIN_PATH")
    # Running clients can retain a deleted executable path after an upgrade.
    binary = (shutil.which(configured) if configured else None) or "herdr"
    result = subprocess.run((binary, *args), text=True, capture_output=True)
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or f"herdr {' '.join(args)} failed")
    return result.stdout


def load(*args: str) -> dict:
    try:
        return json.loads(herdr(*args))["result"]
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        raise SystemExit(f"cannot parse herdr {' '.join(args)} output: {exc}")


def foreground_process(process_info: dict) -> dict | None:
    """Return the process whose PID matches Herdr's foreground process group."""
    process_group_id = process_info.get("foreground_process_group_id")
    if process_group_id is None:
        return None

    return next(
        (
            proc
            for proc in process_info.get("foreground_processes", [])
            if str(proc.get("pid")) == str(process_group_id)
        ),
        None,
    )


def proc_names(process: dict | None) -> list[str]:
    if not process:
        return []

    values = [process.get("name"), process.get("argv0")]
    argv = process.get("argv") or []
    if argv:
        values.append(argv[0])
    return [Path(value).name for value in values if value]


def passthrough_reason(process_info: dict) -> str | None:
    """Return 'vim' or 'ssh' when the foreground process should receive the raw key."""
    names = set(proc_names(foreground_process(process_info)))
    if names & VIM_NAMES:
        return "vim"
    if names & SSH_NAMES:
        return "ssh"
    return None


def is_vim(process_info: dict) -> bool:
    return passthrough_reason(process_info) == "vim"


def route(process_info: dict, direction: str, key: str) -> tuple[str, str]:
    if passthrough_reason(process_info) is not None:
        return "send-key", f"ctrl+{key}"
    return "focus", direction


def self_check() -> None:
    nvim = {
        "foreground_process_group_id": 101,
        "foreground_processes": [{"name": "nvim", "pid": 101}],
    }
    assert route(nvim, "left", "h") == ("send-key", "ctrl+h"), "nvim internal split route"
    assert route(nvim, "right", "l") == ("send-key", "ctrl+l"), "nvim edge route"
    assert passthrough_reason(nvim) == "vim", "nvim passthrough reason"

    shell_with_nvim_descendant = {
        "foreground_process_group_id": 200,
        "foreground_processes": [
            {"name": "zsh", "pid": 200},
            {"name": "nvim", "pid": 201},
        ],
    }
    assert route(shell_with_nvim_descendant, "down", "j") == ("focus", "down"), "non-nvim direct Herdr focus"
    assert passthrough_reason(shell_with_nvim_descendant) is None, "plain shell has no passthrough"

    # Shape matches `herdr pane process-info` for `ssh -o ProxyCommand=...`.
    ssh = {
        "foreground_process_group_id": 300,
        "foreground_processes": [
            {"name": "sleep", "argv0": "sleep", "argv": ["sleep", "600"], "pid": 301},
            {"name": "ssh", "argv0": "ssh", "argv": ["ssh", "remote-host"], "pid": 300},
        ],
    }
    for direction, key in (("left", "h"), ("down", "j"), ("up", "k"), ("right", "l")):
        assert route(ssh, direction, key) == ("send-key", f"ctrl+{key}"), f"ssh forwards ctrl+{key}"
    assert passthrough_reason(ssh) == "ssh", "ssh passthrough reason"

    ssh_by_path = {
        "foreground_process_group_id": 400,
        "foreground_processes": [{"name": "ssh", "argv0": "/usr/bin/ssh", "argv": ["/usr/bin/ssh", "host"], "pid": 400}],
    }
    assert route(ssh_by_path, "up", "k") == ("send-key", "ctrl+k"), "ssh by absolute path forwards"

    shell_with_ssh_descendant = {
        "foreground_process_group_id": 500,
        "foreground_processes": [
            {"name": "zsh", "pid": 500},
            {"name": "ssh", "pid": 501},
        ],
    }
    assert route(shell_with_ssh_descendant, "left", "h") == ("focus", "left"), "backgrounded ssh keeps Herdr focus"

    opencode = {
        "foreground_process_group_id": 600,
        "foreground_processes": [{"name": "opencode.exe", "argv0": "opencode", "pid": 600}],
    }
    assert route(opencode, "right", "l") == ("focus", "right"), "other TUIs keep Herdr focus"

    assert route({}, "left", "h") == ("focus", "left"), "missing process info falls back to focus"


def main() -> int:
    parser = argparse.ArgumentParser(description="tmux-navigator-style Herdr pane navigation")
    parser.add_argument("direction", nargs="?", choices=("left", "right", "up", "down"))
    parser.add_argument("key", nargs="?", choices=("h", "j", "k", "l"))
    parser.add_argument("--status", action="store_true", help="show the decision without acting")
    parser.add_argument("--self-test", action="store_true", help="run routing contract checks")
    parser.add_argument("--pane", metavar="ID", help="target this pane instead of the current one")
    args = parser.parse_args()

    if args.self_test:
        self_check()
        return 0
    if args.direction is None or args.key is None:
        parser.error("direction and key are required unless --self-test is used")

    if args.pane:
        pane = load("pane", "get", args.pane)["pane"]
    else:
        pane = load("pane", "current")["pane"]
    pane_id = pane["pane_id"]
    process_info = load("pane", "process-info", "--pane", pane_id)["process_info"]
    action_type, action_value = route(process_info, args.direction, args.key)
    passthrough = action_type == "send-key"
    action = f"send {action_value}" if passthrough else f"focus {action_value}"

    if args.status:
        reason = passthrough_reason(process_info) or "none"
        print(
            f"pane={pane_id} passthrough={reason} vim={str(is_vim(process_info)).lower()} action={action} "
            f"processes={','.join(proc_names(foreground_process(process_info)))}"
        )
        return 0

    if passthrough:
        herdr("pane", "send-keys", pane_id, action_value)
    else:
        herdr("pane", "focus", "--direction", action_value, "--pane", pane_id)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
