# Invoked by herdr-python to avoid project-specific mise Python settings.
import argparse
import fcntl
import json
import shlex
import shutil
import subprocess
import tempfile
from collections import Counter
from pathlib import Path


MRU_PATH = Path.home() / ".cache" / "herdr-last" / "workspace-mru.json"
LAST_WORKSPACE_PATH = Path.home() / ".cache" / "herdr-last" / "workspace"
PROJECT_ROOTS = tuple(Path.home() / root for root in ("", "whatif", "personal", "homelab", "work"))
OPEN_ENTRY = "+ Open folder..."
PATH_ENTRY = "+ Enter path..."
BROWSE_ENTRY = "+ Browse folders (including hidden)..."
ROOTS_PATH = Path.home() / ".local" / "state" / "herdr-picker" / "roots.json"


def command(name: str) -> str:
    found = shutil.which(name)
    if not found:
        raise SystemExit(f"{name} not found")
    return found


def herdr(*args: str) -> str:
    result = subprocess.run(("herdr", *args), text=True, capture_output=True)
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or f"herdr {' '.join(args)} failed")
    return result.stdout


def run(*args: str, cwd: Path | None = None) -> str | None:
    result = subprocess.run(args, cwd=cwd, text=True, capture_output=True)
    return result.stdout.strip() if result.returncode == 0 else None


def workspaces() -> list[dict]:
    try:
        return json.loads(herdr("workspace", "list"))["result"]["workspaces"]
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        raise SystemExit(f"cannot parse herdr workspace list output: {exc}")


def load(*args: str) -> dict:
    try:
        response = json.loads(herdr(*args))
        if "error" in response:
            raise SystemExit(f"herdr {' '.join(args)} failed: {response['error']}")
        return response["result"]
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        raise SystemExit(f"cannot parse herdr {' '.join(args)} output: {exc}")


def mru_order() -> list[str]:
    try:
        data = json.loads(MRU_PATH.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return []
    return data if isinstance(data, list) else []


def touch_mru(workspace_id: str, valid_ids: set[str]) -> None:
    MRU_PATH.parent.mkdir(parents=True, exist_ok=True)
    # ponytail: picker-driven MRU; add Herdr focus hooks if Herdr exposes them later.
    MRU_PATH.write_text(json.dumps(updated_mru(workspace_id, mru_order(), valid_ids)))


def updated_mru(workspace_id: str, ordered: list[str], valid_ids: set[str]) -> list[str]:
    return [workspace_id, *(item for item in ordered if item != workspace_id and item in valid_ids)]


def remember_previous_workspace(workspace_id: str) -> None:
    LAST_WORKSPACE_PATH.parent.mkdir(parents=True, exist_ok=True)
    LAST_WORKSPACE_PATH.write_text(workspace_id + "\n")


def sort_by_mru(items: list[dict]) -> list[dict]:
    rank = {workspace_id: index for index, workspace_id in enumerate(mru_order())}
    return sorted(items, key=lambda item: rank.get(item["workspace_id"], len(rank) + item.get("number", 0)))


def line(workspace: dict) -> str:
    return workspace.get("label") or workspace["workspace_id"]


def workspace_entries(items: list[dict]) -> dict[str, dict]:
    counts = Counter(line(item) for item in items)
    return {
        (f"{line(item)}  [{item['workspace_id']}]" if counts[line(item)] > 1
         or line(item).startswith("+") else line(item)): item
        for item in items
    }


def should_focus(target: str | None, current: str) -> bool:
    return bool(target and target != current)


def project_paths() -> set[Path]:
    paths = set()
    for root in PROJECT_ROOTS:
        if not root.is_dir():
            continue
        for path in root.iterdir():
            if path.is_dir() and not path.name.startswith("."):
                paths.add(path)
    return paths


def folder_entries() -> dict[str, Path]:
    home = Path.home()
    entries = {}
    for value in zoxide_dirs():
        path = Path(value)
        label = f"~/{path.relative_to(home)}" if path.is_relative_to(home) else str(path)
        entries[label] = path
    return entries


def git_label(cwd: Path) -> str:
    top = run("git", "rev-parse", "--show-toplevel", cwd=cwd)
    if not top:
        return cwd.name or "~"

    worktrees = run("git", "worktree", "list", "--porcelain", cwd=cwd)
    branch = None
    main = None
    current = str(Path(top).resolve())
    if worktrees:
        active = None
        for raw in worktrees.splitlines():
            if raw.startswith("worktree "):
                active = raw.removeprefix("worktree ")
                main = main or active
            elif active == current and raw.startswith("branch refs/heads/"):
                branch = raw.removeprefix("branch refs/heads/")
    if main and current != str(Path(main).resolve()) and branch:
        return Path(branch).name
    return Path(top).name


def read_roots(items: list[dict]) -> dict[str, str]:
    try:
        data = json.loads(ROOTS_PATH.read_text())
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError:
        raise SystemExit(f"Invalid workspace folder mapping: {ROOTS_PATH}")
    if not isinstance(data, dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in data.items()):
        raise SystemExit(f"Invalid workspace folder mapping: {ROOTS_PATH}")
    valid = {item["workspace_id"] for item in items}
    return {key: value for key, value in data.items() if key in valid}


def save_roots(roots: dict[str, str]) -> None:
    with tempfile.NamedTemporaryFile("w", dir=ROOTS_PATH.parent, delete=False) as handle:
        path = Path(handle.name)
        json.dump(roots, handle)
    try:
        path.replace(ROOTS_PATH)
    finally:
        path.unlink(missing_ok=True)


def matching_workspaces(cwd: Path, items: list[dict], roots: dict[str, str]) -> list[dict]:
    # Once bound, a workspace's folder does not change when a pane runs cd.
    return [item for item in items if roots.get(item["workspace_id"]) == str(cwd)]


def open_folder(cwd: Path, label: str | None = None, ask_name: bool = False) -> str | None:
    cwd = cwd.expanduser().resolve()
    if not cwd.is_dir():
        raise SystemExit(f"Not a directory: {cwd}")
    ROOTS_PATH.parent.mkdir(parents=True, exist_ok=True)
    # Serialize the lookup/create pair across simultaneous picker invocations.
    with ROOTS_PATH.with_suffix(".lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        items = sort_by_mru(workspaces())
        roots = read_roots(items)
        matches = matching_workspaces(cwd, items, roots)
        if matches:
            if len(matches) == 1:
                target = matches[0]["workspace_id"]
            else:
                entries = workspace_entries(matches)
                selected = pick(list(entries), header=f"Already open: {cwd}")
                if selected not in entries:
                    return None
                target = entries[selected]["workspace_id"]
            if label:
                load("workspace", "rename", target, label)
        else:
            default = git_label(cwd)
            if ask_name and label is None:
                label = input(f"Workspace name [{default}]: ").strip() or default
            created = load("workspace", "create", "--cwd", str(cwd), "--label", label or default, "--no-focus")
            target = created["workspace"]["workspace_id"]
            load("tab", "rename", created["tab"]["tab_id"], default)
        roots[target] = str(cwd)
        save_roots(roots)
        return target


def zoxide_dirs() -> list[str]:
    history = (run("zoxide", "query", "-l") or "").splitlines() if shutil.which("zoxide") else []
    # Preserve zoxide's ranking, canonicalize aliases, and drop stale entries.
    candidates = [*history, *sorted(str(path) for path in project_paths())]
    return list(dict.fromkeys(str(Path(path).expanduser().resolve()) for path in candidates if Path(path).expanduser().is_dir()))


def browse_folder(cwd: Path) -> Path | None:
    while True:
        try:
            children = sorted((path for path in cwd.iterdir() if path.is_dir()), key=lambda path: path.name.lower())
        except PermissionError:
            print(f"Cannot read {cwd}")
            cwd = cwd.parent
            continue
        entries = {str(path): path for path in children}
        selected = pick([". Open this folder", ".. Parent folder", *entries], header=str(cwd), prompt="folder> ")
        if selected is None:
            return None
        if selected == ". Open this folder":
            return cwd
        if selected == ".. Parent folder":
            cwd = cwd.parent
        elif selected in entries:
            cwd = entries[selected]


def pick_folder() -> Path | None:
    selected = pick([PATH_ENTRY, BROWSE_ENTRY, *zoxide_dirs()], header="Open folder: reuse or create", prompt="dir> ")
    if selected == PATH_ENTRY:
        value = input("Folder path (blank cancels): ").strip()
        return Path(value).expanduser() if value else None
    if selected == BROWSE_ENTRY:
        return browse_folder(Path.home())
    return Path(selected) if selected else None


def pick(lines: list[str], header: str = "Herdr workspaces", prompt: str = "workspace> ") -> str | None:
    tv = shutil.which("tv") or shutil.which("television")
    if not tv:
        raise SystemExit("Television CLI not found: install tv or television in PATH")

    with tempfile.NamedTemporaryFile("w", delete=False) as handle:
        path = Path(handle.name)
        handle.write("\n".join(lines) + "\n")

    try:
        result = subprocess.run(
            (
                tv,
                "--source-command",
                f"cat {shlex.quote(str(path))}",
                "--input-header",
                header,
                "--input-prompt",
                prompt,
                "--no-remote",
                "--no-preview",
            ),
            text=True,
            stdout=subprocess.PIPE,
        )
    finally:
        path.unlink(missing_ok=True)

    if result.returncode != 0 or not result.stdout.strip():
        return None
    return result.stdout.strip()


def self_check() -> None:
    def check(condition: bool, message: str) -> None:
        if not condition:
            raise SystemExit(f"self-check failed: {message}")

    workspace = {"workspace_id": "workspace-0", "label": "project"}
    check(line(workspace) == "project", "workspace labels stay clean")
    check(line({"workspace_id": "workspace-0"}) == "workspace-0", "workspace IDs remain a fallback")
    entries = workspace_entries([workspace, {"workspace_id": "workspace-1", "label": "project"}])
    check(len(entries) == 2, "duplicate labels remain individually selectable")
    check(updated_mru("workspace-1", ["workspace-2", "workspace-1", "stale"], {"workspace-1", "workspace-2"}) == ["workspace-1", "workspace-2"], "MRU updates keep the selected valid workspace first")


def main() -> int:
    parser = argparse.ArgumentParser(description="Pick and focus a Herdr workspace with Television.")
    parser.add_argument("--status", action="store_true", help="print available workspace rows and exit")
    parser.add_argument("--dry-run", action="store_true", help="verify dependencies and print the current workspace")
    parser.add_argument("--self-check", action="store_true", help="validate picker labels")
    parser.add_argument("--open", type=Path, help="open a folder, reusing its workspace")
    parser.add_argument("--label", help="name the opened workspace (also renames an existing match)")
    args = parser.parse_args()
    if args.label is not None and (args.open is None or not args.label.strip()):
        parser.error("--label requires --open and a nonempty name")

    if args.self_check:
        self_check()
        return 0

    command("herdr")
    items = workspaces()
    valid_ids = {workspace["workspace_id"] for workspace in items}
    current = next((workspace["workspace_id"] for workspace in items if workspace.get("focused")), "-")
    items = sort_by_mru(items)
    if not args.status and not args.dry_run and current != "-":
        touch_mru(current, valid_ids)
        items = sort_by_mru(items)
    entries = workspace_entries(items)
    folders = folder_entries()
    # Keep workspace and folder choices distinct even with path-like workspace names.
    folders = {(f"{label}  [folder]" if label in entries else label): path for label, path in folders.items()}
    lines = [*entries, *folders, OPEN_ENTRY]

    if args.status:
        print("\n".join(lines))
        return 0

    if args.dry_run:
        print(f"current={current} workspaces={len(items)} television={shutil.which('tv') or shutil.which('television') or '-'}")
        return 0

    if args.open is not None:
        target = open_folder(args.open, args.label)
    else:
        selected = pick(lines)
        if selected == OPEN_ENTRY:
            cwd = pick_folder()
            target = open_folder(cwd, ask_name=True) if cwd else None
        elif selected in folders:
            target = open_folder(folders[selected])
        else:
            target = entries.get(selected or "", {}).get("workspace_id")
    if target and should_focus(target, current):
        load("workspace", "focus", target)
        if current != "-":
            remember_previous_workspace(current)
    if target:
        touch_mru(target, {workspace["workspace_id"] for workspace in workspaces()})
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (EOFError, KeyboardInterrupt):
        raise SystemExit(0)
