# Invoked by herdr-python to avoid project-specific mise Python settings.
import json
import subprocess
from pathlib import Path


def herdr(*args: str) -> str:
    result = subprocess.run(("herdr", *args), text=True, capture_output=True)
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or f"herdr {' '.join(args)} failed")
    return result.stdout


def run(*args: str, cwd: Path) -> str | None:
    result = subprocess.run(args, cwd=cwd, text=True, capture_output=True)
    return result.stdout.strip() if result.returncode == 0 else None


def label_for(cwd: Path) -> str:
    top = run("git", "rev-parse", "--show-toplevel", cwd=cwd)
    if not top:
        return cwd.name or "~"

    branch = run("git", "branch", "--show-current", cwd=cwd)
    return Path(branch).name if branch else Path(top).name


def main() -> int:
    pane = json.loads(herdr("pane", "current"))["result"]["pane"]
    cwd = Path(pane.get("foreground_cwd") or pane.get("cwd") or Path.home()).expanduser().resolve()
    herdr("tab", "rename", pane["tab_id"], label_for(cwd))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
