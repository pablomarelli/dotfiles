{{- $profile := (index . "install_profile") | default "full" -}}
{{- $gatewayEnabled := and (eq $profile "full") (stat (joinPath .chezmoi.homeDir ".config/opencode/secrets/databricks-token")) -}}
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "{{ if eq $profile "remote" }}opencode/mimo-v2.5-free{{ else }}openai/gpt-6.1-sol{{ end }}",
  "small_model": "{{ if eq $profile "remote" }}opencode/ling-3.0-flash-fin-free{{ else }}openai/gpt-5.6-luna{{ end }}",

  "agents": {
    "plan": { "disabled": true },
    "concise": { "hidden": true },
    "minimal": { "hidden": true }
  },

  "providers": {
{{ if $gatewayEnabled }}
    "databricks-anthropic": {
      "name": "Databricks Anthropic Gateway",
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "https://dbc-6db7fae2-336b.cloud.databricks.com/ai-gateway/anthropic/v1",
        "apiKey": "{file:~/.config/opencode/secrets/databricks-token}"
      },
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/secrets/databricks-token}",
        "x-databricks-use-coding-agent-mode": "true"
      },
      "models": {
        "system.ai.claude-fable-5-1": {
          "name": "Fable 5.1 via Databricks Gateway",
          "settings": {
            "toolStreaming": false,
            "thinking": {
              "type": "disabled"
            }
          },
          "body": {
            "thinking": {
              "type": "adaptive"
            },
            "output_config": {
              "effort": "low"
            }
          },
          "variants": [
            {
              "id": "low",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "low" } }
            },
            {
              "id": "medium",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "medium" } }
            },
            {
              "id": "high",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "high" } }
            },
            {
              "id": "xhigh",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "xhigh" } }
            },
            {
              "id": "max",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "max" } }
            }
          ]
        },
        "system.ai.claude-opus-5-5": {
          "name": "Opus 5.5 via Databricks Gateway",
          "settings": {
            "toolStreaming": false,
            "thinking": {
              "type": "disabled"
            }
          },
          "body": {
            "thinking": {
              "type": "adaptive"
            },
            "output_config": {
              "effort": "low"
            }
          },
          "variants": [
            {
              "id": "low",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "low" } }
            },
            {
              "id": "medium",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "medium" } }
            },
            {
              "id": "high",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "high" } }
            },
            {
              "id": "xhigh",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "xhigh" } }
            },
            {
              "id": "max",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "max" } }
            }
          ]
        },
        "system.ai.claude-sonnet-5-5": {
          "name": "Sonnet 5.5 via Databricks Gateway",
          "settings": {
            "toolStreaming": false,
            "thinking": {
              "type": "disabled"
            }
          },
          "body": {
            "thinking": {
              "type": "adaptive"
            },
            "output_config": {
              "effort": "low"
            }
          },
          "variants": [
            {
              "id": "low",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "low" } }
            },
            {
              "id": "medium",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "medium" } }
            },
            {
              "id": "high",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "high" } }
            },
            {
              "id": "xhigh",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "xhigh" } }
            },
            {
              "id": "max",
              "settings": { "thinking": { "type": "disabled" } },
              "body": { "output_config": { "effort": "max" } }
            }
          ]
        }
      }
    },
    "databricks-openai": {
      "name": "Databricks OpenAI Gateway",
      "package": "@opencode/ai/providers/openai/responses",
      "settings": {
        "baseURL": "https://dbc-6db7fae2-336b.cloud.databricks.com/ai-gateway/openai/v1",
        "apiKey": "{file:~/.config/opencode/secrets/databricks-token}",
        "transport": "http"
      },
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/secrets/databricks-token}",
        "x-databricks-use-coding-agent-mode": "true"
      },
      "models": {
        "system.ai.gpt-6-astra": {
          "name": "GPT-6 Astra via Databricks Gateway",
          "settings": {
            "reasoningEffort": "low",
            "store": null
          },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "system.ai.gpt-6-1-sol": {
          "name": "GPT-6.1 Sol via Databricks Gateway",
          "settings": {
            "reasoningEffort": "low",
            "store": null
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        }
      }
    },
{{ end }}
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "low"
          }
        }
      }
    }
  },

{{ if eq $profile "full" }}
  "skills": {
    "paths": ["~/.config/opencode/skills-work"]
  },
{{ end }}
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "**/*.key", "effect": "deny" },
    { "action": "read", "resource": "**/*.pem", "effect": "deny" },
    { "action": "read", "resource": "**/.aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "**/.config/gh/hosts.yml", "effect": "deny" },
    { "action": "read", "resource": "**/.credentials/**", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "**/Library/Keychains/**", "effect": "deny" },
    { "action": "read", "resource": "**/credentials.json", "effect": "deny" },
    { "action": "read", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
{{ if eq $profile "full" }}
      "atlassian": {
        "type": "local",
        "codemode": false,
        "command": [
          "uvx",
          "--python",
          "3.12",
          "mcp-atlassian@0.23.1"
        ],
        "environment": {
          "JIRA_URL": "{env:JIRA_URL}",
          "JIRA_USERNAME": "{env:JIRA_USERNAME}",
          "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
        }
      },
{{ end }}
      "fff": {
        "type": "local",
        "command": [
          "fff-mcp"
        ]
      },
{{ if eq $profile "full" }}
      "Devops-MCP-hub": {
        "command": [
          "{{ .chezmoi.homeDir }}/.local/bin/uvx",
          "mcp-proxy-for-aws@1.6.5",
          "https://mcp-devops-services-gpnvcnqr9d.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp",
          "--service",
          "bedrock-agentcore",
          "--region",
          "us-east-1",
          "--profile",
          "devops-prod-sso"
        ],
        "type": "local"
      },
{{ end }}
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }{{ if eq $profile "full" }},
      "sentry": {
        "type": "local",
        "command": [
          "zsh",
          "-lc",
          "SENTRY_ACCESS_TOKEN=$(SENTRY_URL=\"https://sentry.jan.gl\" sentry auth token) exec npx -y @sentry/mcp-server@0.39.0 --host=sentry.jan.gl"
        ]
      }{{ end }}{{ if ne $profile "remote" }},
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.83",
          "--output-dir",
          "{{ .chezmoi.homeDir }}/.tmp/opencode/playwright-mcp"
        ]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.10.1",
          "--no-usage-statistics"
        ]
      }{{ end }}
    }
  },
  "websearch": {
    "provider": "random"
  }
}
