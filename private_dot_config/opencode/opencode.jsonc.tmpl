{{- $profile := (index . "install_profile") | default "remote" -}}
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "{{ if eq $profile "remote" }}opencode/mimo-v2.5-free{{ else }}openai/gpt-5.6-sol{{ end }}",
  "small_model": "{{ if eq $profile "remote" }}opencode/ling-3.0-flash-fin-free{{ else }}openai/gpt-5.6-luna{{ end }}",
  "skills": {
    "paths": ["~/.config/opencode/skills-work"]
  },
  "permission": {
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    },
    "read": {
      "*": "allow",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/.aws/credentials": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "**/.credentials/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/Library/Keychains/**": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  },
  "mcp": {
{{ if eq $profile "full" }}
    "atlassian": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.12",
        "mcp-atlassian==0.23.1"
      ],
      "enabled": true,
      "environment": {
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    },
{{ end }}
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ],
      "enabled": true
    },
{{ if eq $profile "full" }}
    "Devops-MCP-hub": {
      "command": [
        "{{ .chezmoi.homeDir }}/.local/bin/uvx",
        "mcp-proxy-for-aws==1.6.5",
        "https://mcp-devops-services-gpnvcnqr9d.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp",
        "--service",
        "bedrock-agentcore",
        "--region",
        "us-east-1",
        "--profile",
        "devops-prod-sso"
      ],
      "enabled": true,
      "type": "local"
    },
{{ end }}
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }{{ if eq $profile "full" }},
    "sentry": {
      "type": "local",
      "command": [
        "zsh",
        "-lc",
        "SENTRY_ACCESS_TOKEN=$(SENTRY_URL=\"https://sentry.jan.gl\" sentry auth token) exec npx -y @sentry/mcp-server@0.39.0 --host=sentry.jan.gl"
      ],
      "enabled": true
    }{{ end }}
  }
}
