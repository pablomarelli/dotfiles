    },
    "databricks-openai": {
      "name": "Databricks OpenAI Gateway",
      "package": "@opencode/ai/providers/openai/responses",
      "settings": {
        "baseURL": "https://dbc-6db7fae2-336b.cloud.databricks.com/ai-gateway/openai/v1",
        "apiKey": "{file:~/.config/opencode/secrets/databricks-token}",
        "transport": "http"
      },
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/secrets/databricks-token}",
        "x-databricks-use-coding-agent-mode": "true"
      },
      "models": {
        "system.ai.gpt-6-astra": {
          "name": "GPT-6 Astra via Databricks Gateway",
          "settings": {
            "reasoningEffort": "low",
            // Omit the unsupported Responses store parameter.
            "store": null
          },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "system.ai.gpt-6-1-sol": {
          "name": "GPT-6.1 Sol via Databricks Gateway",
          "settings": {
            "reasoningEffort": "low",
            // Omit the unsupported Responses store parameter.
            "store": null
          },
          "variants": [
            // OpenAI "fast" service tier (2x price, ~2-4x output tok/s). Databricks blocks "ultrafast".
            { "id": "fast", "settings": { "reasoningEffort": "low", "serviceTier": "fast" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        }
      }
    },
{{ end }}
    "openai": {
      // Applies to every OpenAI model; per-model settings and variants override.
      "settings": {
        "reasoningEffort": "low"
      }
    }
  },

{{ if eq $profile "full" }}
  "skills": {
    "paths": ["~/.config/opencode/skills-work"]
  },
{{ end }}

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    // Shell commands run without a prompt. Only commands that can lose work, rewrite
    // history, or change shared state ask. OpenCode checks each part of a chain, pipe,
    // or $(...) separately. It matches the command text as written, case-sensitively.
    // The leading "*" and the "*" between words also match env prefixes (FOO=1 git),
    // wrappers (env, xargs, sh -c, eval), absolute paths, global options (git -C), and
    // extra spaces. Scripts and text built at run time cannot be checked.
    { "action": "shell", "resource": "*", "effect": "allow" },

    // Git: discard uncommitted work.
    { "action": "shell", "resource": "*git* reset*--hard*", "effect": "ask" },
    { "action": "shell", "resource": "*git* reset*--merge*", "effect": "ask" },
    { "action": "shell", "resource": "*git* checkout *", "effect": "ask" },
    { "action": "shell", "resource": "*git* restore *", "effect": "ask" },
    { "action": "shell", "resource": "*git* clean *", "effect": "ask" },
    { "action": "shell", "resource": "*git* switch*--discard-changes*", "effect": "ask" },
    { "action": "shell", "resource": "*git* switch*--force*", "effect": "ask" },
    { "action": "shell", "resource": "*git* switch* -f*", "effect": "ask" },
    { "action": "shell", "resource": "*git* switch* -C*", "effect": "ask" },
    { "action": "shell", "resource": "*git* stash*drop*", "effect": "ask" },
    { "action": "shell", "resource": "*git* stash*clear*", "effect": "ask" },
    { "action": "shell", "resource": "*git*--abort*", "effect": "ask" },
    { "action": "shell", "resource": "*git* worktree*remove*--force*", "effect": "ask" },
    { "action": "shell", "resource": "*git* worktree*remove* -f*", "effect": "ask" },

    // Git: rewrite history or delete refs. The "commit --amend" rule is at the end.
    { "action": "shell", "resource": "*git* rebase *", "effect": "ask" },
    { "action": "shell", "resource": "*git* branch* -d*", "effect": "ask" },
    { "action": "shell", "resource": "*git* branch* -D*", "effect": "ask" },
    { "action": "shell", "resource": "*git* branch*--delete*", "effect": "ask" },
    { "action": "shell", "resource": "*git* branch* -f*", "effect": "ask" },
    { "action": "shell", "resource": "*git* branch*--force*", "effect": "ask" },
    { "action": "shell", "resource": "*git* branch* -M*", "effect": "ask" },
    { "action": "shell", "resource": "*git* branch* -C*", "effect": "ask" },
    { "action": "shell", "resource": "*git* tag* -d*", "effect": "ask" },
    { "action": "shell", "resource": "*git* tag*--delete*", "effect": "ask" },
    { "action": "shell", "resource": "*git* tag* -f*", "effect": "ask" },
    { "action": "shell", "resource": "*git* tag*--force*", "effect": "ask" },
    { "action": "shell", "resource": "*git* filter-branch*", "effect": "ask" },
    { "action": "shell", "resource": "*git* filter-repo*", "effect": "ask" },
    { "action": "shell", "resource": "*git* update-ref*", "effect": "ask" },
    { "action": "shell", "resource": "*git* reflog*expire*", "effect": "ask" },
    { "action": "shell", "resource": "*git* reflog*delete*", "effect": "ask" },

    // Git: change the remote. Normal pushes and "push -u" run without a prompt.
    // " -?f" catches combined flags such as -uf. It also asks for --follow-tags.
    { "action": "shell", "resource": "*git* push*--force*", "effect": "ask" },
    { "action": "shell", "resource": "*git* push* -f*", "effect": "ask" },
    { "action": "shell", "resource": "*git* push* -?f*", "effect": "ask" },
    { "action": "shell", "resource": "*git* push*+*", "effect": "ask" },
    { "action": "shell", "resource": "*git* push*--delete*", "effect": "ask" },
    { "action": "shell", "resource": "*git* push* -d*", "effect": "ask" },
    { "action": "shell", "resource": "*git* push* :*", "effect": "ask" },
    { "action": "shell", "resource": "*git* push*--mirror*", "effect": "ask" },
    { "action": "shell", "resource": "*git* push*--prune*", "effect": "ask" },

    // GitHub CLI: merges, deletes, and gh api writes. Read-only gh api calls run.
    { "action": "shell", "resource": "*gh* pr* merge *", "effect": "ask" },
    { "action": "shell", "resource": "*gh* delete*", "effect": "ask" },
    { "action": "shell", "resource": "*gh* api* -X*", "effect": "ask" },
    { "action": "shell", "resource": "*gh* api*--method*", "effect": "ask" },
    { "action": "shell", "resource": "*gh* api* -f*", "effect": "ask" },
    { "action": "shell", "resource": "*gh* api* -F*", "effect": "ask" },
    { "action": "shell", "resource": "*gh* api*--field*", "effect": "ask" },
    { "action": "shell", "resource": "*gh* api*--raw-field*", "effect": "ask" },
    { "action": "shell", "resource": "*gh* api*--input*", "effect": "ask" },

    // Other destructive commands.
    { "action": "shell", "resource": "*sudo *", "effect": "ask" },
    { "action": "shell", "resource": "*rm -r*", "effect": "ask" },
    { "action": "shell", "resource": "*rm -R*", "effect": "ask" },
    { "action": "shell", "resource": "*rm -?r*", "effect": "ask" },
    { "action": "shell", "resource": "*rm -?R*", "effect": "ask" },
    { "action": "shell", "resource": "*rm -* -r*", "effect": "ask" },
    { "action": "shell", "resource": "*rm -* -R*", "effect": "ask" },
    { "action": "shell", "resource": "*rm *--recursive*", "effect": "ask" },
    { "action": "shell", "resource": "*find *-delete*", "effect": "ask" },

    // Kubernetes and Helm: delete, change, or restart cluster resources. The spaces
    // around each subcommand let "kubectl get applications" run.
    { "action": "shell", "resource": "*kubectl* delete*", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl* drain*", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl* apply *", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl* patch *", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl* scale *", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl* edit *", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl* replace *", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl* set *", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl* rollout* restart*", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl* rollout* undo*", "effect": "ask" },
    { "action": "shell", "resource": "*helm* uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "*helm* delete *", "effect": "ask" },
    { "action": "shell", "resource": "*helm* del *", "effect": "ask" },

    // Argo CD: delete apps or repos, and sync options that delete or recreate
    // resources. A plain "argocd app sync" runs.
    { "action": "shell", "resource": "*argocd* delete*", "effect": "ask" },
    { "action": "shell", "resource": "*argocd* rm *", "effect": "ask" },
    { "action": "shell", "resource": "*argocd* sync*--prune*", "effect": "ask" },
    { "action": "shell", "resource": "*argocd* sync*--force*", "effect": "ask" },
    { "action": "shell", "resource": "*argocd* sync*--replace*", "effect": "ask" },

    // Terraform, OpenTofu, and Terragrunt: destroy, apply, and state changes. A plain
    // apply waits for a typed "yes", but -auto-approve or a saved plan file applies at
    // once, so every apply asks.
    { "action": "shell", "resource": "*terraform*destroy*", "effect": "ask" },
    { "action": "shell", "resource": "*tofu*destroy*", "effect": "ask" },
    { "action": "shell", "resource": "*terragrunt*destroy*", "effect": "ask" },
    { "action": "shell", "resource": "*terraform* apply *", "effect": "ask" },
    { "action": "shell", "resource": "*tofu* apply *", "effect": "ask" },
    { "action": "shell", "resource": "*terragrunt* apply *", "effect": "ask" },
    { "action": "shell", "resource": "*terraform* state* rm*", "effect": "ask" },
    { "action": "shell", "resource": "*tofu* state* rm*", "effect": "ask" },
    { "action": "shell", "resource": "*terragrunt* state* rm*", "effect": "ask" },
    { "action": "shell", "resource": "*terraform* state* push*", "effect": "ask" },
    { "action": "shell", "resource": "*tofu* state* push*", "effect": "ask" },
    { "action": "shell", "resource": "*terragrunt* state* push*", "effect": "ask" },
    { "action": "shell", "resource": "*terraform* force-unlock*", "effect": "ask" },
    { "action": "shell", "resource": "*tofu* force-unlock*", "effect": "ask" },
    { "action": "shell", "resource": "*terragrunt* force-unlock*", "effect": "ask" },

    // Docker: delete data in volumes, images, and build cache. "*docker*compose*"
    // matches both "docker compose" and "docker-compose".
    { "action": "shell", "resource": "*docker* prune *", "effect": "ask" },
    { "action": "shell", "resource": "*docker* volume* rm *", "effect": "ask" },
    { "action": "shell", "resource": "*docker* volume* remove *", "effect": "ask" },
    { "action": "shell", "resource": "*docker*compose* down* -v*", "effect": "ask" },
    { "action": "shell", "resource": "*docker*compose* down*--volumes*", "effect": "ask" },

    // Code piped into a shell (for example "curl ... | sh") cannot be checked.
    { "action": "shell", "resource": "sh", "effect": "ask" },
    { "action": "shell", "resource": "bash", "effect": "ask" },
    { "action": "shell", "resource": "zsh", "effect": "ask" },
    { "action": "shell", "resource": "sh -s *", "effect": "ask" },
    { "action": "shell", "resource": "bash -s *", "effect": "ask" },
    { "action": "shell", "resource": "zsh -s *", "effect": "ask" },

    // Free text in commit messages, PR bodies, and heredocs can contain the words
    // above. These rules have no leading "*", so a wrapped form such as
    // sh -c "git commit ...; git reset --hard" still asks.
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout -b *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr edit *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr comment *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr review *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue create *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue edit *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue comment *", "effect": "allow" },
    { "action": "shell", "resource": "cat *<<*", "effect": "allow" },
    // Must come after the "git commit *" allow rule.
    { "action": "shell", "resource": "*git* commit*--amend*", "effect": "ask" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "**/*.key", "effect": "deny" },
    { "action": "read", "resource": "**/*.pem", "effect": "deny" },
    { "action": "read", "resource": "**/.aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "**/.config/gh/hosts.yml", "effect": "deny" },
    { "action": "read", "resource": "**/.credentials/**", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "**/Library/Keychains/**", "effect": "deny" },
    { "action": "read", "resource": "**/credentials.json", "effect": "deny" },
    { "action": "read", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    // Argo CD secret apps (jn-argocd, apptness-argocd, jangl-argocd) hold
    // ExternalSecret manifests that reference keys, not values. Must come after
    // the "**/secrets/**" deny rule.
    { "action": "read", "resource": "*argocd/apps/secrets/*/manifest.yaml", "effect": "allow" }
  ],
  "mcp": {
    "servers": {

{{ if eq $profile "full" }}
      "atlassian": {
        "type": "local",
        "codemode": false,
        "command": [
          "uvx",
          "--python",
          "3.12",
          "mcp-atlassian@0.23.1"
        ],
        "environment": {
          "JIRA_URL": "{env:JIRA_URL}",
          "JIRA_USERNAME": "{env:JIRA_USERNAME}",
          "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
        }
      },
{{ end }}
      "fff": {
        "type": "local",
        "command": [
          "fff-mcp"
        ]
      }{{ if ne $profile "remote" }},{{ end }}

{{ if eq $profile "full" }}
      "Devops-MCP-hub": {
        "command": [
          "{{ .chezmoi.homeDir }}/.local/bin/uvx",
          "mcp-proxy-for-aws@1.6.5",
          "https://mcp-devops-services-gpnvcnqr9d.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp",
          "--service",
          "bedrock-agentcore",
          "--region",
          "us-east-1",
          "--profile",
          "devops-prod-sso"
        ],
        "type": "local"
      },
{{ end }}
      // "context7": {
      //   "type": "remote",
      //   "url": "https://mcp.context7.com/mcp"
      // },
{{ if eq $profile "full" }}
      "sentry": {
        "type": "local",
        "command": [
          "zsh",
          "-lc",
          "SENTRY_ACCESS_TOKEN=$(SENTRY_URL=\"https://sentry.jan.gl\" sentry auth token) exec npx -y @sentry/mcp-server@0.39.0 --host=sentry.jan.gl"
        ]
      },
{{ end }}
{{ if ne $profile "remote" }}
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.83",
          // Playwright's bundled Chrome for Testing (com.google.chrome.for.testing) so
          // AeroSpace can route agent browser windows apart from the regular Chrome.
          "--browser",
          "chromium",
          "--output-dir",
          "{{ .chezmoi.homeDir }}/.tmp/opencode/playwright-mcp"
        ]
      },

      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.10.1",
          "--no-usage-statistics"{{ if eq $os "darwin" }},
          // Same Chrome for Testing binary Playwright uses. The chromium-NNNN folder
          // changes when @playwright/mcp above is bumped; update this path with it.
          "--executablePath",
          "{{ .chezmoi.homeDir }}/Library/Caches/ms-playwright/chromium-1234/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing"
{{ end }}
        ]
      }
{{ end }}
    }
  },
  "websearch": {
    "provider": "random"
  }
}
