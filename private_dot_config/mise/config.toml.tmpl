"cargo:navi" = "latest"
"aqua:alexpasmantier/television" = "latest"
"aqua:joshmedeski/sesh" = "latest"
ast-grep = "latest"
starship = "latest"
rust = "latest"
"github:ogulcancelik/herdr" = "latest"
