
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

# Golang
export PATH="$PATH:$HOME/go/bin"

{{ if eq .chezmoi.os "darwin" -}}
# macOS: Homebrew client-only database tools (Apple Silicon and Intel).
for brew_prefix in /opt/homebrew /usr/local; do
  for client in libpq@16 mysql-client; do
    if [[ -d "$brew_prefix/opt/$client/bin" ]]; then
      export PATH="$brew_prefix/opt/$client/bin:$PATH"
    fi
  done
done
unset brew_prefix client

# macOS: Bootdev personal project
export PATH="$PATH:$HOME/personal/bootdev/worldbanc/private/bin"
{{ end -}}

{{ if eq .chezmoi.os "linux" -}}
# Linux: Homebrew
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# Linux: snap bin
export PATH="$PATH:/snap/bin"
{{ end -}}
