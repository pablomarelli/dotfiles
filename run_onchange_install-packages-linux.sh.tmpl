{{- $os := (index . "dotfiles_os") | default .chezmoi.os -}}
{{- $profile := (index . "install_profile") | default "full" -}}
{{- $headless := (index . "install_headless") | default false -}}
{{ if eq $os "linux" -}}
#!/usr/bin/env bash
# Linux (Debian/Ubuntu) bootstrap - re-runs when this rendered profile or Mise config changes
# Mise config hash: {{ includeTemplate "private_dot_config/mise/config.toml.tmpl" . | sha256sum }}
set -e
PROFILE="{{ $profile }}"
HEADLESS="{{ if or (eq (env "DOTFILES_HEADLESS") "1") $headless }}1{{ else }}0{{ end }}"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

command_exists() { command -v "$1" >/dev/null 2>&1; }

download_and_run() {
  local url="$1" script
  script="$(mktemp)"
  trap 'rm -f "$script"' RETURN
  curl -fsSL "$url" -o "$script"
  /bin/bash "$script"
  rm -f "$script"
  trap - RETURN
}

. "${DOTFILES_TEST_OS_RELEASE:-/etc/os-release}"

echo "==> Linux bootstrap"

# ── apt packages ──────────────────────────────────────────────────────────────
# Only things that can't or shouldn't be managed by mise:
#   - zsh, git, gcc: system-level tools
#   - build-essential: needed by cargo/python/gcc builds
#   - curl, wget: needed to bootstrap mise itself
#   - unzip, python3-venv: runtime bootstrap dependencies
#   - alacritty: terminal emulator (not in mise)
APT_PKGS=(
  zsh             # shell
  git             # version control
  gcc             # C compiler
  build-essential # make, libc-dev, etc. (needed by rust/python builds)
  curl            # needed to install mise
  wget            # general download tool
  unzip           # archive extraction used by tooling
  python3-venv    # Python virtual environment support
)

if [[ "$PROFILE" != "remote" ]]; then
  APT_PKGS+=(xclip xdg-utils)
fi

if [[ "$ID" == "ubuntu" ]]; then
  APT_PKGS+=(software-properties-common) # add-apt-repository
fi

echo -e "${YELLOW}→${NC} Updating apt..."
sudo apt update -qq

echo -e "${YELLOW}→${NC} Installing apt packages..."
for pkg in "${APT_PKGS[@]}"; do
  if dpkg -l "$pkg" &>/dev/null; then
    echo -e "  ${GREEN}✓${NC} $pkg"
  else
    echo -e "  ${YELLOW}→${NC} $pkg"
    sudo apt install -y "$pkg"
  fi
done

if [[ "$PROFILE" != "remote" && "$HEADLESS" != "1" ]]; then
  # ── Ghostty (community .deb installer for Ubuntu/Debian) ───────────────────
  if ! command_exists ghostty; then
    echo -e "${YELLOW}→${NC} Installing ghostty..."
    download_and_run "https://raw.githubusercontent.com/mkasberg/ghostty-ubuntu/HEAD/install.sh"
    command_exists ghostty || { echo -e "${RED}✗${NC} ghostty installer completed but ghostty is not on PATH"; exit 1; }
  else
    echo -e "${GREEN}✓${NC} ghostty already installed"
  fi

  # ── Alacritty (PPA, not in mise) ────────────────────────────────────────────
  if ! command_exists alacritty; then
    echo -e "${YELLOW}→${NC} Installing alacritty..."
    if [[ "$ID" == "ubuntu" ]]; then
      sudo add-apt-repository ppa:aslatter/ppa -y || true
      sudo apt update -qq
    fi
    sudo apt install -y alacritty
  else
    echo -e "${GREEN}✓${NC} alacritty already installed"
  fi
elif [[ "$PROFILE" != "remote" ]]; then
  echo -e "${YELLOW}→${NC} Headless mode: skipping Ghostty and Alacritty"
else
  echo -e "${YELLOW}→${NC} Remote profile: skipping GUI terminal installers"
fi

# ── mise ──────────────────────────────────────────────────────────────────────
if ! command_exists mise; then
  echo -e "${YELLOW}→${NC} Installing mise..."
  mise_installer="$(mktemp)"
  trap 'rm -f "$mise_installer"' EXIT
  curl -fsSL https://mise.run -o "$mise_installer"
  sh "$mise_installer"
  rm -f "$mise_installer"
  trap - EXIT
  export PATH="$HOME/.local/bin:$PATH"
fi
command_exists mise || { echo -e "${RED}✗${NC} mise installer completed but mise is not on PATH"; exit 1; }
echo -e "${GREEN}✓${NC} mise installed"

# Some sudo-installed packages create ~/.cache as root on fresh systems.
mkdir -p "$HOME/.cache"
sudo chown -R "$(id -u)":"$(id -g)" "$HOME/.cache"

echo -e "${YELLOW}→${NC} Running mise install for $PROFILE profile (this may take a while)..."
if ! mise install; then
  echo -e "${RED}✗${NC} mise install failed. If GitHub rate limits were involved, run 'gh auth login' or export GITHUB_TOKEN, then retry: '$HOME/.local/bin/mise install'."
  exit 1
fi
echo -e "${GREEN}✓${NC} mise tools installed"

export PATH="$HOME/.local/share/mise/shims:$PATH"
for cmd in unzip go python3; do
  command_exists "$cmd" || { echo -e "${RED}✗${NC} Post-install preflight failed: $cmd is not on PATH"; exit 1; }
done
echo -e "${GREEN}✓${NC} Post-install preflight passed (unzip, go, python3)"

echo ""
echo -e "${GREEN}✓${NC} Linux bootstrap complete. Restart your terminal or run: exec zsh"
{{ end -}}
