{{- $profile := env "DOTFILES_INSTALL_PROFILE" | default "remote" -}}
{{- if not (or (eq $profile "remote") (eq $profile "minimal") (eq $profile "full")) }}{{ fail (printf "invalid DOTFILES_INSTALL_PROFILE %q: expected remote, minimal, or full" $profile) }}{{ end }}
[data]
  name = "Pablo Marelli"
  personal_email = "pablo.marelli.kenny@gmail.com"
  work_email = "pablo.marelli@whatifmediagroup.com"
  include_secrets = {{ eq (env "DOTFILES_INCLUDE_SECRETS") "1" }}
  dotfiles_os = {{ (env "DOTFILES_TEST_OS" | default .chezmoi.os) | quote }}
  install_profile = {{ $profile | quote }}
  install_headless = {{ eq (env "DOTFILES_HEADLESS") "1" }}

[onepassword]
  command = "op"

[diff]
  pager = "delta"
