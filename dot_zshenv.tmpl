# Sourced by every zsh, including non-interactive SSH commands. Keep silent and fast.
path=("${(@)path:#$HOME/.local/bin}")
path=("${(@)path:#$HOME/.local/share/mise/shims}")
path=("$HOME/.local/bin" "$HOME/.local/share/mise/shims" $path)
typeset -U path PATH

{{ if or .install_headless (eq .install_profile "remote") -}}
# This machine is SSH/headless-only. Force 1Password CLI to use manual
# account sign-in instead of trying to connect to the desktop app.
export OP_BIOMETRIC_UNLOCK_ENABLED=false
{{ end -}}
