{{- $profile := (env "DOTFILES_INSTALL_PROFILE" | default (index . "install_profile") | default "full") -}}
{{- $headless := or (eq (env "DOTFILES_HEADLESS") "1") ((index . "install_headless") | default false) -}}
{{- $os := (index . "dotfiles_os") | default .chezmoi.os -}}
{{- $includeSecrets := (index . "include_secrets") | default false -}}
{{- if not (or (eq $profile "remote") (eq $profile "minimal") (eq $profile "full")) }}{{ fail (printf "invalid install_profile %q: expected remote, minimal, or full" $profile) }}{{ end -}}
# Ignore Mac-only configs on Linux
{{ if ne $os "darwin" }}
.config/aerospace
.config/karabiner
{{ end }}

# Ignore Linux-only configs on Mac
{{ if ne $os "linux" }}
.config/i3
.config/albert
{{ end }}

# Never manage tmux plugins (tpm handles them)
.config/tmux/plugins

# Work-specific Pi agents stay local and are discovered recursively.
.pi/agent/agents/work/**

# Managed as private git repos — clone manually on new machines
.config/bruno
.config/httpcollection
.config/dbqueries

# Never manage dependency or language caches anywhere
**/node_modules
**/__pycache__
**/bun.lock
**/package-lock.json

# Never manage nvim plugin lockfile (Lazy updates this automatically)
.config/nvim/lazy-lock.json

# Never manage .env files anywhere (may contain API keys and secrets)
**/.env
**/.env.*
*.env

# Ignore starship backup files (only starship.toml is active)
.config/starship/starshipbackup.toml
.config/starship/starship-bracketed-backup.toml

# Ignore macOS metadata files everywhere
**/.DS_Store

# Repo files — not deployed to home directory
.github
install.sh
dotfiles-plan.sh
README.md
secret-refs.txt
tests

# Ignore shell cache
.cache

# Install profiles are forward-management choices: moving to a smaller profile
# stops managing these targets but does not uninstall tools or delete files.
# Profile contract duplication is intentional: installer, ignore rules, mise, and
# package scripts all enforce the same public bootstrap tiers from different
# surfaces. Tests cover these lists together.
{{ if ne $profile "full" }}
.aws/**
.config/aerospace/**
.config/karabiner/**
.config/albert/**
.config/diffnav/**
.config/gh-dash/**
.config/worktrunk/**
.config/zed/**
.config/navi/jangl.cheat
.config/zsh/jangl.zsh
.config/opencode/commands/reviewpr.md
.gitconfig.work
{{ end }}

{{ if eq $profile "remote" }}
.config/alacritty/**
.config/ghostty/**
.config/herdr/**
.config/navi/**
.config/starship/**
.config/television/**
.config/zsh/cli-tools.zsh
.config/zsh/custom.zsh
.config/zsh/fzf_git_branches.zsh
.config/zsh/oh-my-zsh.zsh
.config/zsh/programming-languages.zsh
.config/zsh/prompt.zsh
.p10k.zsh
run_onchange_install-zsh-plugins.sh
{{ end }}

{{ if and (ne $profile "remote") $headless }}
.config/alacritty/**
.config/ghostty/**
{{ end }}

# Ignore karabiner auto-backups (generated automatically by karabiner)
.config/karabiner/automatic_backups

# Ignore most opencode files; keep only the active configs
.config/opencode/**
!.config/opencode/
!.config/opencode/AGENTS.md
!.config/opencode/AGENTS.local.md
!.config/opencode/commands/
!.config/opencode/commands/writepr.md
{{ if eq $profile "full" }}
!.config/opencode/commands/reviewpr.md
{{ end }}
!.config/opencode/opencode.jsonc
!.config/opencode/skills/
!.config/opencode/skills/**
!.config/opencode/skills-personal/
!.config/opencode/skills-personal/**
# Work skills may contain private company context; never manage them in this public repo.
.config/opencode/skills-work/**
!.config/opencode/tui.json
{{ if and $includeSecrets (ne (env "DOTFILES_FORCE_IGNORE_SECRETS") "1") }}
!.config/opencode/ntfy.env
!.config/opencode/zen.env
{{ end }}
!.config/opencode/plugins/
!.config/opencode/plugins/ntfy.ts

# Secret-backed templates are opt-in. Keep this list in sync with secret-refs.txt
# so new 1Password-backed targets cannot render by default.
{{ if or (not $includeSecrets) (eq (env "DOTFILES_FORCE_IGNORE_SECRETS") "1") }}
.config/opencode/ntfy.env
.config/opencode/zen.env
.aws/credentials
{{ end }}

# Ignore most Zed files; keep only settings and keymap
.config/zed/**
!.config/zed/settings.json
!.config/zed/keymap.json

# AWS: OS-conditional content is handled inside the templates themselves
