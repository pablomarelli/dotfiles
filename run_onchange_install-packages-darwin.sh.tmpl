{{- $os := (index . "dotfiles_os") | default .chezmoi.os -}}
{{- $profile := (index . "install_profile") | default "full" -}}
{{- $headless := (index . "install_headless") | default false -}}
{{ if eq $os "darwin" -}}
#!/usr/bin/env bash
# macOS bootstrap - re-runs when this rendered profile or Mise config changes
# Mise config hash: {{ includeTemplate "private_dot_config/mise/config.toml.tmpl" . | sha256sum }}
set -e
PROFILE="{{ $profile }}"
HEADLESS="{{ if or (eq (env "DOTFILES_HEADLESS") "1") $headless }}1{{ else }}0{{ end }}"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

command_exists() { command -v "$1" >/dev/null 2>&1; }

download_and_run() {
  local url="$1" script
  script="$(mktemp)"
  trap 'rm -f "$script"' RETURN
  curl -fsSL "$url" -o "$script"
  /bin/bash "$script"
  rm -f "$script"
  trap - RETURN
}

echo "==> macOS bootstrap"

# ── Homebrew ──────────────────────────────────────────────────────────────────
if ! command_exists brew; then
  echo -e "${YELLOW}→${NC} Installing Homebrew..."
  download_and_run "https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh"
  # Add common Homebrew locations to PATH without evaluating installer output.
  export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
else
  echo -e "${GREEN}✓${NC} Homebrew already installed"
fi
command_exists brew || { echo -e "${RED}✗${NC} Homebrew installer completed but brew is not on PATH"; exit 1; }

# ── Homebrew packages ─────────────────────────────────────────────────────────
# Only things that can't or shouldn't be managed by mise:
#   - zsh, git, gcc: system-level tools, better via brew on macOS
#   - casks: macOS desktop apps and fonts
BREW_PKGS=(
  zsh           # shell
  git           # version control
  gcc           # C compiler (needed by some cargo/python builds)
)

if [[ "$PROFILE" == "full" ]]; then
  BREW_PKGS+=(
  git-crypt     # git encryption
  dark-notify   # macOS appearance watcher for Neovim
  hunk          # terminal diff viewer
  tailspin      # log highlighter
  bash wget tree btop gnupg ffmpeg # native macOS tools
  mysql-client libpq@16           # client tools only; no database service
  )
elif [[ "$PROFILE" == "minimal" ]]; then
  BREW_PKGS+=(dark-notify)
fi

BREW_CASKS=()
if [[ "$PROFILE" != "remote" && "$HEADLESS" != "1" ]]; then
  BREW_CASKS+=(ghostty)
  if [[ "$PROFILE" == "full" ]]; then
    BREW_CASKS+=(
      ngrok font-symbols-only-nerd-font font-jetbrains-mono
      # Desktop and development
      1password bitwarden nikitabobko/tap/aerospace karabiner-elements
      google-chrome docker-desktop bruno t3-code
      # Database clients
      mongodb-compass mysqlworkbench postico sequel-ace
      # Communication and access
      slack zoom tailscale-app pritunl
      # Other desktop apps. Arc sign-in and use end on 2026-12-22.
      arc chatgpt logitune
    )
  fi
fi

# ── Homebrew taps ─────────────────────────────────────────────────────────────
BREW_TAPS=()
if [[ "$PROFILE" == "minimal" ]]; then
  BREW_TAPS+=(cormacrelf/tap) # dark-notify
elif [[ "$PROFILE" == "full" ]]; then
  BREW_TAPS+=(
    cormacrelf/tap      # dark-notify
    modem-dev/tap       # hunk
    nikitabobko/tap     # AeroSpace
  )
fi

for tap in "${BREW_TAPS[@]}"; do
  if ! brew tap | grep -q "^${tap%%#*}" 2>/dev/null; then
    echo -e "  ${YELLOW}→${NC} tapping ${tap%%#*}..."
    brew tap "${tap%%#*}" || true
  fi
done

echo -e "${YELLOW}→${NC} Installing brew packages..."
for pkg in "${BREW_PKGS[@]}"; do
  if brew list "$pkg" &>/dev/null; then
    echo -e "  ${GREEN}✓${NC} $pkg"
  else
    echo -e "  ${YELLOW}→${NC} $pkg"
    brew install "$pkg"
  fi
done

# Apps may already be supplied by IT, the App Store, or a vendor installer.
# Check both application folders before asking Homebrew to install them.
cask_app_exists() {
  local app
  case "${1##*/}" in
    ghostty) app="Ghostty.app" ;;
    1password) app="1Password.app" ;;
    bitwarden) app="Bitwarden.app" ;;
    aerospace) app="AeroSpace.app" ;;
    karabiner-elements) app="Karabiner-Elements.app" ;;
    google-chrome) app="Google Chrome.app" ;;
    docker-desktop) app="Docker.app" ;;
    bruno) app="Bruno.app" ;;
    t3-code) app="T3 Code (Beta).app" ;;
    mongodb-compass) app="MongoDB Compass.app" ;;
    mysqlworkbench) app="MySQLWorkbench.app" ;;
    postico) app="Postico 2.app" ;;
    sequel-ace) app="Sequel Ace.app" ;;
    slack) app="Slack.app" ;;
    zoom) app="zoom.us.app" ;;
    tailscale-app) app="Tailscale.app" ;;
    pritunl) app="Pritunl.app" ;;
    arc) app="Arc.app" ;;
    chatgpt) app="ChatGPT.app" ;;
    logitune) app="Logi Tune.app" ;;
    *) return 1 ;;
  esac
  [[ -d "${DOTFILES_APPLICATIONS_DIR:-/Applications}/$app" || -d "$HOME/Applications/$app" ]]
}

echo -e "${YELLOW}→${NC} Installing brew casks..."
for cask in "${BREW_CASKS[@]}"; do
  if brew list --cask "$cask" &>/dev/null || cask_app_exists "$cask"; then
    echo -e "  ${GREEN}✓${NC} $cask (already installed)"
  else
    echo -e "  ${YELLOW}→${NC} $cask"
    if ! brew install --cask "$cask"; then
      echo -e "${RED}✗${NC} Failed to install $cask. Resolve the Homebrew error, then rerun chezmoi apply."
      exit 1
    fi
  fi
done

# ── mise ──────────────────────────────────────────────────────────────────────
if ! command_exists mise; then
  echo -e "${YELLOW}→${NC} Installing mise..."
  mise_installer="$(mktemp)"
  trap 'rm -f "$mise_installer"' EXIT
  curl -fsSL https://mise.run -o "$mise_installer"
  sh "$mise_installer"
  rm -f "$mise_installer"
  trap - EXIT
  export PATH="$HOME/.local/bin:$HOME/.local/share/mise/bin:$PATH"
fi
command_exists mise || { echo -e "${RED}✗${NC} mise installer completed but mise is not on PATH"; exit 1; }
echo -e "${GREEN}✓${NC} mise installed"

echo -e "${YELLOW}→${NC} Running mise install for $PROFILE profile (this may take a while)..."
if ! mise install; then
  echo -e "${RED}✗${NC} mise install failed. If GitHub rate limits were involved, run 'gh auth login' or export GITHUB_TOKEN, then retry: '$HOME/.local/bin/mise install'."
  exit 1
fi
echo -e "${GREEN}✓${NC} mise tools installed"

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
if [[ "$PROFILE" == "full" ]] && ! command_exists terminal-browser; then
  echo -e "${YELLOW}→${NC} Installing terminal-browser..."
  TERMINAL_BROWSER_SKIP_SETUP=1 download_and_run "https://terminal-browser.sh/install"
  command_exists terminal-browser || { echo -e "${RED}✗${NC} terminal-browser installer did not create its launcher"; exit 1; }
fi
for cmd in unzip go python3; do
  command_exists "$cmd" || { echo -e "${RED}✗${NC} Post-install preflight failed: $cmd is not on PATH"; exit 1; }
done
echo -e "${GREEN}✓${NC} Post-install preflight passed (unzip, go, python3)"

echo ""
echo -e "${GREEN}✓${NC} macOS bootstrap complete. Restart your terminal or run: exec zsh"
{{ end -}}
